{
  "name": "qoop-os",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "smoke": "tsx --env-file=.env scripts/smoke.ts",
    "knowledge:import": "tsx --env-file=.env scripts/import-knowledge.ts",
    "knowledge:context": "node --import tsx scripts/knowledge-context.ts",
    "knowledge:ask": "node --import tsx scripts/knowledge-ask.ts",
    "knowledge:verify": "tsx --env-file=.env scripts/verify-knowledge.ts",
    "studio:verify": "node --env-file=.env --import tsx scripts/verify-studio.ts",
    "analysis:start": "node scripts/start-analysis-worker.mjs",
    "analysis:worker": "node --env-file=.env --import tsx scripts/analysis-worker.ts",
    "system:audit": "node --env-file=.env --import tsx scripts/system-audit.ts",
    "keywords:seed": "node --env-file=.env --import tsx scripts/seed-keyword-watch.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@prisma/client": "^6.19.3",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}

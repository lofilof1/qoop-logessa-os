DATABASE_URL=postgresql://qoop:qoop_local_password@localhost:5432/qoop
POSTGRES_USER=qoop
POSTGRES_PASSWORD=qoop_local_password
POSTGRES_DB=qoop
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=qoop_local
S3_SECRET_KEY=qoop_local_secret_change_me
S3_BUCKET=qoop-assets
MAX_UPLOAD_MB=100

# Optional: alternatively configure the API key in Studio. Never use NEXT_PUBLIC_.
OPENAI_API_KEY=
# Docker uses its persistent runtime volume; local dev defaults to .runtime/.
